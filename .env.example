# ══════════════════════════════════════════════
# CryptoTerminal Backend — Variáveis de Ambiente
# ══════════════════════════════════════════════
# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA suba o arquivo ".env" para o GitHub (já está no .gitignore).

# Porta do servidor (Railway/Render definem automaticamente, pode deixar assim)
PORT=3000

# Chave secreta para assinar os tokens de login (JWT)
# Gere uma aleatória forte, ex: rode no terminal: openssl rand -hex 32
JWT_SECRET=troque_por_uma_chave_aleatoria_bem_grande_aqui

# ── STRIPE ──
# Pegue em https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# ID do preço recorrente de R$49,90/mês (crie em https://dashboard.stripe.com/products)
STRIPE_PRICE_ID=price_XXXXXXXXXXXXXXXXXXXXXXXX

# URL do seu frontend (PWA), usada nos redirects do Stripe Checkout
FRONTEND_URL=https://cripto.netlify.app

# Limite de análises gratuitas por usuário (Zonas IA + Risco de Alavancagem juntos)
FREE_ANALYSIS_LIMIT=3
